model Permission {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  category        String
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id              String               @id @default(cuid())
  name            String               @unique
  description     String?
  isActive        Boolean              @default(true)
  isSystem        Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  rolePermissions RolePermission[]
  userRoles       UserRoleAssignment[]

  @@map("roles")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id             String    @id @default(cuid())
  userId         String    @unique
  roleId         String
  assignedBy     String?
  assignedAt     DateTime  @default(now())
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  assignedByUser User?     @relation("RoleAssignments", fields: [assignedBy], references: [id])
  role           Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_role_assignments")
}

model ApplicationInterview {
  id             String           @id @default(cuid())
  applicationId  String
  interviewerId  String
  scheduledDate  DateTime
  completedAt    DateTime?
  status         String           @default("SCHEDULED")
  notes          String?
  interviewNotes String?
  overallScore   Float?
  overallComment String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  application    Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer    User             @relation("Interviewer", fields: [interviewerId], references: [id], onDelete: Cascade)
  scores         InterviewScore[]

  @@unique([applicationId, interviewerId])
  @@map("application_interviews")
}

model InterviewCriteria {
  id          String           @id @default(cuid())
  name        String
  description String?
  maxScore    Int              @default(10)
  weight      Float            @default(1.0)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  order       Int              @default(0)
  scores      InterviewScore[]

  @@map("interview_criteria")
}

model InterviewScore {
  id          String               @id @default(cuid())
  interviewId String
  criteriaId  String
  score       Float
  comments    String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  criteria    InterviewCriteria    @relation(fields: [criteriaId], references: [id], onDelete: Cascade)
  interview   ApplicationInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([interviewId, criteriaId])
  @@map("interview_scores")
}

model OTP {
  id        String   @id @default(cuid())
  phone     String
  otp       String
  type      String   @default("PASSWORD_RESET")
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, type])
  @@index([expiresAt])
  @@map("otps")
}

model farmers {
  id                 String    @id @default(cuid())
  mccId              String
  farmerCode         String?   @unique
  name               String
  phone              String
  location           String
  village            String?
  registrationDate   DateTime  @default(now())
  isActive           Boolean   @default(true)
  totalAmountEarned  Float     @default(0)
  lastCollectionDate DateTime?
  defaultPriceGroup  String?

  // Enhanced farmer registry fields
  nfcId            String?   @unique // NFC/ID number
  nationalId       String?   @unique // National ID number
  herdSize         Int? // Number of cows
  gpsLatitude      Float? // GPS latitude
  gpsLongitude     Float? // GPS longitude
  geoConsent       Boolean   @default(false)
  geoConsentAt     DateTime?
  geoCreatedAt     DateTime?
  geoUpdatedAt     DateTime?
  creditLimit      Float?    @default(0) // Credit limit for purchases
  emergencyContact String? // Emergency contact phone
  email            String? // Email address
  address          String? // Detailed address

  // Farm-Level Data Module fields
  defaultCollectionCenterId String? // Default collection center (MCC)
  paymentMethod             PaymentMethod? // Ikofi / MoMo / bank
  district                  String? // District (admin hierarchy)
  sector                    String? // Sector (admin hierarchy)
  cell                      String? // Cell (admin hierarchy)

  // Payment & Banking fields
  ikofiId              String? @unique // iKOFI Wallet ID
  bankAccountNumber    String? // Bank account number
  bankName             String? // Bank name (e.g., Bank of Kigali)
  totalVolumeCollected Float   @default(0) // Total volume collected (liters, kg, etc.)

  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  mccs                    mccs                       @relation(fields: [mccId], references: [id])
  defaultCollectionCenter mccs?                      @relation("FarmerDefaultCollectionCenter", fields: [defaultCollectionCenterId], references: [id])
  assignedAgents          farmer_agent_assignments[]
  milk_collections        milk_collections[]
  mcc_payments            mcc_payments[]
  payments                payments[]                 @relation("FarmerPayments")
  rentals                 rentals[]
  sales                   sales[]
  farmer_account          farmer_accounts?
  ledger_entries          farmer_ledger[]
  questionnaire_responses questionnaire_responses[]
  crop_collections        crop_collections[]
  commodity_collections   commodity_collections[]
  service_deliveries      service_deliveries[]
  season_plans            season_plans[]
  input_usage_logs        input_usage_logs[]
  agentPrepayments        agent_prepayments[]
  availabilitySignals     pre_collection_availability_signals[]

  @@index([mccId])
  @@index([phone])
  @@index([farmerCode])
  @@index([nfcId])
  @@index([nationalId])
}

model mcc_periods {
  id                 String             @id
