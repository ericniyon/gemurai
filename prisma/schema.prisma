  @@index([code])
  @@index([managerUserId])
}

model milk_collections {
  id              String               @id @default(cuid())
  farmerId        String
  mccPeriodId     String?
  mccId           String?
  collectionDate  DateTime
  period          Int
  totalLiters     Float
  unitPrice       Float
  totalAmount     Float
  stockMoveId     String?
  warehouseId     String?
  locationId      String?
  productId       String?
  deductions      Json                 @default("{}")
  advances        Float                @default(0)
  totalDeductions Float                @default(0)
  netPayment      Float                @default(0)
  status          MilkCollectionStatus @default(PENDING)

  // Quality test fields
  fat                   Float?
  protein               Float?
  lactometerReading     Float?
  antibioticTest        Boolean @default(false)
  tempCelsius           Float?
  timeSinceMilkingHours Float?
  qualityStatus         String  @default("pending") // pending, accepted, rejected
  qualityNotes          String?

  // Traceability fields
  sampleTag   String? @unique
  agentId     String?
  photoUrl    String?
  geolocation Json? // { lat, lng } or PostGIS point
  synced      Boolean @default(false)

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  farmers      farmers        @relation(fields: [farmerId], references: [id])
  locations    Location?      @relation(fields: [locationId], references: [id])
  mcc_periods  mcc_periods?   @relation(fields: [mccPeriodId], references: [id])
  products     products?      @relation(fields: [productId], references: [id])
  stock_moves  StockMove?     @relation(fields: [stockMoveId], references: [id])
  warehouses   Warehouse?     @relation(fields: [warehouseId], references: [id])
  mccs         mccs?          @relation(fields: [mccId], references: [id])
  agent        User?          @relation("MilkCollectionAgent", fields: [agentId], references: [id])
  mcc_payments mcc_payments[]
  batch        bulk_batches?  @relation(fields: [batchId], references: [id])
  batchId      String?

  @@index([collectionDate])
  @@index([farmerId])
  @@index([productId])
  @@index([stockMoveId])
  @@index([sampleTag])
  @@index([agentId])
  @@index([mccId])
  @@index([qualityStatus])
}

model milk_processing {
  id                                                    String   @id @default(cuid())
  mccId                                                 String
  rawMilkProductId                                      String
  processedProductId                                    String
  inputQuantity                                         Float
  outputQuantity                                        Float
  processingDate                                        DateTime
  processingSteps                                       Json     @default("{}")
  qualityMetrics                                        Json     @default("{}")
  status                                                String   @default("PENDING")
  createdAt                                             DateTime @default(now())
  updatedAt                                             DateTime
  mccs                                                  mccs     @relation(fields: [mccId], references: [id])
  products_milk_processing_processedProductIdToproducts products @relation("milk_processing_processedProductIdToproducts", fields: [processedProductId], references: [id])
  products_milk_processing_rawMilkProductIdToproducts   products @relation("milk_processing_rawMilkProductIdToproducts", fields: [rawMilkProductId], references: [id])

  @@index([mccId])
  @@index([processedProductId])
  @@index([rawMilkProductId])
}

model products {
