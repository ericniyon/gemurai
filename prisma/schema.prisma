  @@index([mccId])
  @@index([saleDate])
  @@index([paymentStatus])
  @@index([companyName])
}

model mccs {
  id                      String                    @id @default(cuid())
  code                    String?                   @unique
  name                    String
  location                String
  region                  String?
  address                 String?
  contactInfo             Json                      @default("{}")
  settings                Json                      @default("{}")
  managerUserId           String?                   @unique
  isActive                Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  farmers                 farmers[]
  mcc_periods             mcc_periods[]
  mcc_warehouses          mcc_warehouses[]
