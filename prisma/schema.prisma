  manufacturer                                                 String?
  maxOrderQuantity                                             Int?
  minOrderQuantity                                             Int?
  requiresSpecialHandling                                      Boolean                @default(false)
  shippingWeight                                               Float?
  warrantyInfo                                                 String?
  commission                                                   Float                  @default(0)
  certifications                                               String[]
