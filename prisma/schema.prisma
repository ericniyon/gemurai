  ANALGESICS
  ANTIHISTAMINES
  CARDIOVASCULAR
  DIABETES
  RESPIRATORY
  GASTROINTESTINAL
  DERMATOLOGICAL
  NEUROLOGICAL
  HORMONAL
  VITAMINS
  OTHER
}

enum PrescriptionStatus {
  PENDING
  APPROVED
  DISPENSED
  REJECTED
  EXPIRED
}

enum ExpiryAlertLevel {
  NONE
  WARNING
  CRITICAL
  EXPIRED
}

enum PaymentStatus {
  pending
  paid
  partial
}

enum CropCollectionStatus {
  PENDING
  APPROVED
  PAID
  PROCESSED
  REJECTED
}

enum ServiceType {
  RENTAL
  DELIVERY
  CONSULTATION
  TRAINING
  MAINTENANCE
  OTHER
}

enum ServiceDeliveryStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

enum ReconciliationType {
  COLLECTION
  PAYMENT
  INVENTORY
  PERIOD
}

enum ReconciliationStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  DISPUTED
}

// HarvestPlus Enums
enum CommodityPricingMethod {
  SPOT
  GRADE_BASED
  DEFERRED
  POST_SALE
}

enum QualityFieldType {
  NUMERIC
  DROPDOWN
  BOOLEAN
  INDICATOR
  TEXT
}

enum QualityDataType {
  PERCENTAGE
  DECIMAL
  INTEGER
  STRING
  BOOLEAN
}

enum QualityRuleType {
  PASS
  FAIL
  CONDITIONAL
  WARNING
}

enum CommodityCollectionStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  PROCESSED
  CANCELLED
}

// FR-1: Where collection took place
enum CollectionPointType {
  FARM_GATE
  VILLAGE_HUB
  COLLECTION_CENTER
  COLD_ROOM
  PROCESSOR_INTAKE
}

// FR-2: How commodity was transported
enum TransportMode {
  BICYCLE
  MOTORCYCLE
  TRICYCLE
  FOUR_WHEELER
}

// Journey 0: Pre-Collection Availability Signal source
enum AvailabilitySignalSource {
  PCA       // Pre-Collection Agent
  FARMER_SELF
  COOP_SCOUT
}

enum AvailabilitySignalStatus {
  ACTIVE    // Visible to aggregators
  RESERVED  // Route accepted
  COLLECTED
  EXPIRED
}

model mcc_payments {
  id                    String                 @id @default(cuid())
  farmerId              String
  collectionId           String?                // For milk_collections (legacy)
  commodityCollectionId  String?                // For commodity_collections (multi-commodity)
  mccId                 String
  totalAmount           Float
  deductions            Float                  @default(0)
  advances              Float                  @default(0)
  netPayment            Float
  paymentMethod         PaymentMethod
  paymentStatus         PaymentStatus         @default(pending)
  paymentDate           DateTime
  processedBy           String
  notes                 String                 @default("")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  farmers               farmers                @relation(fields: [farmerId], references: [id])
  milk_collections      milk_collections?      @relation(fields: [collectionId], references: [id])
  commodity_collections commodity_collections? @relation(fields: [commodityCollectionId], references: [id])
  mccs                  mccs                   @relation(fields: [mccId], references: [id])

  @@index([farmerId])
  @@index([collectionId])
  @@index([commodityCollectionId])
  @@index([mccId])
  @@index([paymentDate])
  @@index([paymentStatus])
}

enum PaymentMethod {
  cash
  mobile_money
  bank_transfer
  ikofi
}

// Bulk batches for milk bulking operations
model bulk_batches {
  id                      String              @id @default(cuid())
  mccId                   String
  createdAt               DateTime            @default(now())
  dispatched              Boolean             @default(false)
  dispatchedToProcessorId String?
  totalLiters             Float               @default(0)
  mccs                    mccs                @relation(fields: [mccId], references: [id])
  milk_collections        milk_collections[]
  agentPrepayments        agent_prepayments[]

  @@index([mccId])
  @@index([dispatched])
}

// Staff & contracts (workforce)
model staff {
  id             String    @id @default(cuid())
  userId         String?   @unique
  mccId          String?
  position       String?
  employmentType String? // permanent, contract, seasonal
  startDate      DateTime?
  endDate        DateTime?
  trainingLevel  String?
  certifications String[]
  payrollAccount String?
  createdAt      DateTime  @default(now())
  user           User?     @relation(fields: [userId], references: [id])
  mcc            mccs?     @relation(fields: [mccId], references: [id])

  @@index([mccId])
  @@index([userId])
}

// Vehicles & Transport
model vehicles {
  id              String    @id @default(cuid())
  regNo           String    @unique
  vehicleType     String? // pickup, tanker, van
  capacityLiters  Float?
  status          String    @default("available") // available, on_route, maintenance
  lastMaintenance DateTime?
  createdAt       DateTime  @default(now())

  @@index([status])
}

// Generators & Power assets
model power_assets {
  id         String    @id @default(cuid())
  mccId      String
  name       String?
  assetType  String? // generator, solar, inverter
  capacityKw Float?
  lastTested DateTime?
  status     String    @default("operational")
  createdAt  DateTime  @default(now())
  mcc        mccs      @relation(fields: [mccId], references: [id])

  @@index([mccId])
  @@index([status])
}

// Capacity assessments
model capacity_assessments {
  id                         String   @id @default(cuid())
  mccId                      String
  assessedAt                 DateTime @default(now())
  assessorUserId             String?
  staffCount                 Int?
  trainedStaffCount          Int?
  coolingCapacityLiters      Float?
  estimatedDailyDemandLiters Float?
  transportCapacityLiters    Float?
  powerOk                    Boolean?
  notes                      String?
  mcc                        mccs     @relation(fields: [mccId], references: [id])
  assessor                   User?    @relation("CapacityAssessor", fields: [assessorUserId], references: [id])

  @@index([mccId, assessedAt(sort: Desc)])
}

// Suppliers
model suppliers {
  id           String         @id @default(cuid())
  name         String
  phone        String?
  email        String?
  address      String?
  // Geo-location fields (read-only)
  gpsLatitude  Float?
  gpsLongitude Float?
  geoConsent   Boolean        @default(false)
  geoConsentAt DateTime?
  geoCreatedAt DateTime?
  geoUpdatedAt DateTime?
  createdAt    DateTime       @default(now())
  procurements procurements[]
}

// Procurements
model procurements {
  id          String              @id @default(cuid())
  supplierId  String
  mccId       String?
  procuredAt  DateTime            @default(now())
  totalAmount Float?
  status      String              @default("received") // ordered, received, cancelled
  supplier    suppliers           @relation(fields: [supplierId], references: [id])
  mcc         mccs?               @relation(fields: [mccId], references: [id])
  items       procurement_items[]

  @@index([mccId])
  @@index([supplierId])
}

// Procurement items
model procurement_items {
  id            String       @id @default(cuid())
  procurementId String
  productId     String
  qty           Float
  unitPrice     Float
  procurement   procurements @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  product       products     @relation(fields: [productId], references: [id])

  @@index([procurementId])
  @@index([productId])
}

// Assets & Rentals
model assets {
  id                String    @id @default(cuid())
  serial            String    @unique
  name              String?
  assetType         String? // tracker, milk_meter, chiller, generator, solar, pump, other
  status            String    @default("available") // available, rented, maintenance
  rentable          Boolean   @default(true) // whether this asset can be rented to farmers
  currentHolderType String? // farmer, mcc, vendor
  currentHolderId   String?
  purchasedAt       DateTime?
  notes             String?
  // Type-specific: capacity (e.g. liters for chiller/tank), weight, extra specs (capacityKw, capacityW, measurements, etc.)
  capacityLiters    Float?    // cooling/tank capacity in liters; pump flow can use specifications
  weightKg          Float?
  specifications    Json?    @default("{}") // measurements, capacityKw, capacityW, capacityLitersPerMin, dimensions, etc.
  createdAt         DateTime  @default(now())
  rentals           rentals[]

  @@index([status])
  @@index([assetType])
  @@index([rentable])
}

// Rentals
model rentals {
  id              String         @id @default(cuid())
  assetId         String
  farmerId        String?
  mccId           String?
  rentStart       DateTime?
  rentEnd         DateTime?
  rentFeePerDay   Float?
  deposit         Float?
  returned        Boolean        @default(false)
  returnedAt      DateTime?
  contractDoc     String?
  // Enhanced contract management fields
  contractTerms   Json?
  contractStart   DateTime?
  contractEnd     DateTime?
  autoRenew       Boolean        @default(false)
  renewalPeriod   Int?
  contractStatus  ContractStatus @default(ACTIVE)
  signedBy        String?
  signedAt        DateTime?
  contractVersion Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  asset           assets         @relation(fields: [assetId], references: [id])
  farmer          farmers?       @relation(fields: [farmerId], references: [id])
  mcc             mccs?          @relation(fields: [mccId], references: [id])
  signedByUser    User?          @relation("RentalSigner", fields: [signedBy], references: [id])

  @@index([assetId])
  @@index([farmerId])
  @@index([mccId])
  @@index([contractStatus])
}

// Farmer accounts & ledgers
model farmer_accounts {
  id          String   @id @default(cuid())
  farmerId    String   @unique
  balance     Float    @default(0)
  lastUpdated DateTime @default(now())
  farmer      farmers  @relation(fields: [farmerId], references: [id])
}

// Farmer ledger
model farmer_ledger {
  id           String   @id @default(cuid())
  farmerId     String
  entryAt      DateTime @default(now())
  type         String? // COLLECTION, SALE, PAYMENT, ADJUSTMENT
  amount       Float
  balanceAfter Float
  refId        String?
  notes        String?
  farmer       farmers  @relation(fields: [farmerId], references: [id])

  @@index([farmerId, entryAt(sort: Desc)])
}

// Sales (product sales)
model sales {
  id            String       @id @default(cuid())
  mccId         String
  farmerId      String?
  agentId       String?
  saleAt        DateTime     @default(now())
  totalAmount   Float
  paymentMethod String? // CASH, MOMO, CREDIT
  paid          Boolean      @default(false)
  invoiceNo     String?
  mcc           mccs         @relation(fields: [mccId], references: [id])
  farmer        farmers?     @relation(fields: [farmerId], references: [id])
  agent         User?        @relation("SalesAgent", fields: [agentId], references: [id])
  items         sale_items[]

  @@index([mccId])
  @@index([farmerId])
  @@index([saleAt])
}

// Sale items
model sale_items {
  id        String   @id @default(cuid())
  saleId    String
  productId String
  qty       Float
  unitPrice Float
  sale      sales    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   products @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

// Payments (generic)
model payments {
  id        String   @id @default(cuid())
  farmerId  String
  amount    Float
  method    String? // cash, mobile_money, bank_transfer
  reference String?
  paidAt    DateTime @default(now())
  farmer    farmers  @relation("FarmerPayments", fields: [farmerId], references: [id])

  @@index([farmerId])
  @@index([paidAt])
  @@map("payments")
}

// Questionnaires
model questionnaires {
  id        String                    @id @default(cuid())
  code      String                    @unique
  title     String?
  version   Int                       @default(1)
  schema    Json? // JSON schema to validate responses
  createdAt DateTime                  @default(now())
  responses questionnaire_responses[]
}

// Questionnaire responses
model questionnaire_responses {
  id               String         @id @default(cuid())
  questionnaireId  String
  mccId            String?
  farmerId         String?
  respondentUserId String?
  response         Json?
  submittedAt      DateTime       @default(now())
  questionnaire    questionnaires @relation(fields: [questionnaireId], references: [id])
  mcc              mccs?          @relation(fields: [mccId], references: [id])
  farmer           farmers?       @relation(fields: [farmerId], references: [id])
  respondent       User?          @relation("QuestionnaireRespondent", fields: [respondentUserId], references: [id])

  @@index([questionnaireId])
  @@index([mccId])
  @@index([farmerId])
}

// Geo-audit log for governance
model geoAuditLog {
  id         String   @id @default(cuid())
  userId     String
  userName   String?
  userRole   String?
  action     String // CREATE, UPDATE, DELETE, VIEW, EXPORT, CONSENT_GRANTED, CONSENT_REVOKED, ACCESS_DENIED
  entityType String // farmer, agent, mcc, warehouse, customer, supplier, milk_collection
  entityId   String
  entityName String?
  oldValue   String? // JSON: { latitude, longitude }
  newValue   String? // JSON: { latitude, longitude }
  ipAddress  String?
  userAgent  String?
  metadata   String? // JSON: additional context
  timestamp  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([timestamp])
  @@map("geo_audit_logs")
}

// ============================================
// HARVESTPLUS: Multi-Commodity Platform
// ============================================

// Commodity Categories
model commodity_categories {
  id                 String        @id @default(cuid())
  name               String        @unique
  description        String?
  defaultStorageType String? // tank, bags, silo, warehouse
  status             String        @default("active") // active, inactive
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  commodities        commodities[]

  @@index([status])
  @@map("commodity_categories")
}

// Commodities (Dynamic Definition)
model commodities {
  id                          String                 @id @default(cuid())
  name                        String
  code                        String                 @unique
  categoryId                  String
  unitOfMeasure               String // liters, kg, bags
  pricingMethod               CommodityPricingMethod
  storageType                 String // tank, bags, silo, warehouse
  isPerishable                Boolean                @default(false) // Perishable (Digital) vs non-perishable (cereals)
  defaultCollectionCenterType  String? // MCC, coffee_washing_station, warehouse
  defaultCollectionFrequency  String? // daily, weekly, seasonal
  isActive                    Boolean                @default(true)
  metadata                    Json? // Additional commodity-specific config
  inventoryProductId          String?                // Product used when receiving this commodity into warehouse
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt

  category         commodity_categories       @relation(fields: [categoryId], references: [id])
  qualityFields    commodity_quality_fields[]
  qualityRules     commodity_quality_rules[]
  seasonPlans      season_plans[]
  inputCatalog     input_catalog[]
  collections        commodity_collections[]
  agentPrepayments   agent_prepayments[]
  inventoryBatches   inventory_batches[]
  inventoryProduct   products?                  @relation("CommodityInventoryProduct", fields: [inventoryProductId], references: [id])
  trainingModules   TrainingModule[]
  availabilitySignals pre_collection_availability_signals[]

  @@index([code])
  @@index([categoryId])
  @@index([isActive])
  @@index([inventoryProductId])
  @@map("commodities")
}

// Dynamic Quality Fields (Per Commodity)
model commodity_quality_fields {
  id           String           @id @default(cuid())
  commodityId  String
  fieldName    String // e.g. "Fat %", "Moisture %", "Grade"
  fieldType    QualityFieldType
  dataType     QualityDataType
  options      Json? // For dropdown fields
  isMandatory  Boolean          @default(false)
  displayOrder Int              @default(0)
  description  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  commodity    commodities               @relation(fields: [commodityId], references: [id], onDelete: Cascade)
  qualityRules commodity_quality_rules[]

  @@index([commodityId])
  @@index([displayOrder])
  @@map("commodity_quality_fields")
}

// Quality Validation Rules
model commodity_quality_rules {
  id                String          @id @default(cuid())
  commodityId       String
  qualityFieldId    String?
  ruleName          String
  ruleType          QualityRuleType // pass, fail, conditional
  thresholdValue    Float?
  thresholdOperator String? // >, <, >=, <=, ==, !=
  impactOnPricing   Boolean         @default(false)
  pricingMultiplier Float? // If quality affects price
  errorMessage      String?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  commodity    commodities               @relation(fields: [commodityId], references: [id], onDelete: Cascade)
  qualityField commodity_quality_fields? @relation(fields: [qualityFieldId], references: [id], onDelete: Cascade)

  @@index([commodityId])
  @@index([isActive])
  @@map("commodity_quality_rules")
}

// Quality & compliance audit (schema changes, quality overrides)
model quality_audit_log {
  id          String   @id @default(cuid())
  entityType  String   // quality_field, quality_rule, quality_result
  entityId    String
  commodityId  String?
  collectionId String?  // For quality_result / override
  action      String   // QUALITY_SCHEMA_UPDATE, QUALITY_FIELD_ADDED, QUALITY_RULE_ADDED, QUALITY_OVERRIDE, etc.
  oldValue    Json?
  newValue    Json?
  userId      String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([entityType])
  @@index([entityId])
  @@index([commodityId])
  @@index([createdAt])
  @@map("quality_audit_log")
}

// Season Plans (Farm-Level Planning)
model season_plans {
  id                       String   @id @default(cuid())
  farmerId                 String
  commodityId              String
  season                   String // A, B, C, or custom
  plotHerdReference        String? // Plot ID or herd reference
  expectedHarvestVolume    Float
  expectedHarvestStartDate DateTime
  expectedHarvestEndDate   DateTime
  collectionFrequency      String? // Auto-filled from commodity, but editable
  region                   String? // Region for region-specific calendars
  status                   String   @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED, CANCELLED
  actualHarvestVolume      Float?
  notes                    String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  farmer     farmers            @relation(fields: [farmerId], references: [id])
  commodity  commodities        @relation(fields: [commodityId], references: [id])
  inputUsage input_usage_logs[]

  @@index([farmerId])
  @@index([commodityId])
  @@index([season])
  @@index([status])
  @@index([region])
  @@map("season_plans")
}

// Input Catalog (Farm-Level Inputs)
model input_catalog {
  id               String   @id @default(cuid())
  commodityId      String
  name             String
  category         String // feed, vet, fertilizer, seed, etc.
  unit             String // kg, liters, bags, etc.
  pricingReference Float? // Optional pricing reference
  description      String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  commodity commodities        @relation(fields: [commodityId], references: [id])
  usageLogs input_usage_logs[]

  @@index([commodityId])
  @@index([category])
  @@map("input_catalog")
}

// Input Usage Logs
model input_usage_logs {
  id             String   @id @default(cuid())
  seasonPlanId   String
  inputCatalogId String
  farmerId       String
  quantity       Float
  unit           String
  usageDate      DateTime @default(now())
  cost           Float?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  seasonPlan   season_plans  @relation(fields: [seasonPlanId], references: [id])
  inputCatalog input_catalog @relation(fields: [inputCatalogId], references: [id])
  farmer       farmers       @relation(fields: [farmerId], references: [id])

  @@index([seasonPlanId])
  @@index([farmerId])
  @@index([usageDate])
  @@map("input_usage_logs")
}

// ID Verifications
model id_verifications {
  id                 String    @id @default(cuid())
  entityType         String // farmer, agent, user
  entityId           String
  nationalId         String
  agentId            String? // For agents
  verificationStatus String    @default("PENDING") // PENDING, VERIFIED, REJECTED
  verifiedBy         String?
  verifiedAt         DateTime?
  verificationMethod String? // MANUAL, API, DOCUMENT_SCAN
  verificationNotes  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  verifiedByUser User? @relation("IDVerifier", fields: [verifiedBy], references: [id])

  @@unique([entityType, entityId])
  @@index([nationalId])
  @@index([verificationStatus])
  @@index([entityType, entityId])
  @@map("id_verifications")
}

// Commodity Collections (Generalized from milk_collections and crop_collections)
model commodity_collections {
  id              String                    @id @default(cuid())
  commodityId     String
  farmerId        String
  mccId           String
  periodId        String? // Can link to mcc_periods or crop_periods
  collectionDate  DateTime
  quantity        Float
  unit            String
  qualityData     Json                      @default("{}") // Dynamic quality fields
  qualityScore    Float? // Calculated quality score
  pricePerUnit    Float
  totalAmount     Float
  deductions      Json                      @default("{}")
  advances        Float                     @default(0)
  agentAdvance    Float                     @default(0) // Agent prepayment
  totalDeductions Float                     @default(0)
  netPayment      Float                     @default(0)
  status          CommodityCollectionStatus @default(PENDING)
  warehouseId     String?
  locationId      String?
  productId       String?
  stockMoveId     String?
  agentId         String?
  batchId         String? // For lot-based traceability
  notes           String?
  collectionPointType String?           // FR-1: FARM_GATE, VILLAGE_HUB, COLLECTION_CENTER, COLD_ROOM, PROCESSOR_INTAKE
  transportMode   String?              // FR-2: BICYCLE, MOTORCYCLE, TRICYCLE, FOUR_WHEELER
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  commodity        commodities         @relation(fields: [commodityId], references: [id])
  farmer           farmers             @relation(fields: [farmerId], references: [id])
  mcc              mccs                @relation(fields: [mccId], references: [id])
  warehouse        Warehouse?          @relation(fields: [warehouseId], references: [id])
  location         Location?           @relation(fields: [locationId], references: [id])
  product          products?           @relation(fields: [productId], references: [id])
  stockMove        StockMove?          @relation(fields: [stockMoveId], references: [id])
  agent            User?               @relation("CommodityCollectionAgent", fields: [agentId], references: [id])
  agentPrepayments agent_prepayments[]
  mcc_payments     mcc_payments[]

  @@index([commodityId])
  @@index([farmerId])
  @@index([mccId])
  @@index([collectionDate])
  @@index([status])
  @@index([agentId])
  @@map("commodity_collections")
}

// Journey 0: Pre-Collection Availability Signal (supply discovery before trucks move)
model pre_collection_availability_signals {
  id                  String                    @id @default(cuid())
  commodityId         String
  farmerId            String?                    // Optional: unattributed cluster
  createdByUserId     String?                    // PCA, or farmer (self-report), or coop scout
  sourceType          AvailabilitySignalSource   // PCA | FARMER_SELF | COOP_SCOUT
  status              AvailabilitySignalStatus   @default(ACTIVE)
  estimatedQuantity   Float
  unit                String
  readinessAt         DateTime                   // When commodity will be ready
  qualityIndicators   Json?                      @default("{}") // Basic quality hints
  locationDescription String?                    // Village, sector, etc.
  gpsLatitude         Float?
  gpsLongitude        Float?
  storageCondition    String                     // cold | ambient
  mccId               String?                   // Target MCC if known
  expiresAt           DateTime?                  // Time-bound visibility
  notes               String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  commodity   commodities @relation(fields: [commodityId], references: [id], onDelete: Cascade)
  farmer      farmers?    @relation(fields: [farmerId], references: [id], onDelete: SetNull)
  createdBy   User?       @relation("AvailabilitySignalsCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)
  mcc         mccs?       @relation(fields: [mccId], references: [id], onDelete: SetNull)

  @@index([commodityId])
  @@index([farmerId])
  @@index([status])
  @@index([readinessAt])
  @@index([mccId])
  @@index([createdByUserId])
  @@map("pre_collection_availability_signals")
}

// Inventory Batch (Commodity-aware warehousing per spec)
model inventory_batches {
  id                String   @id @default(cuid())
  commodityId       String
  grade             String?  // Quality grade (A1, A2, B, etc.)
  quantity          Float
  unit              String
  storageLocation   String?  // Warehouse/location reference
  ownerType         String   // farmer | agent | mcc
  financingStatus   String?  // PENDING, FINANCED, RELEASED, etc.
  batchId           String?  // Link to collection batch for traceability
  mccId             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  commodity commodities @relation(fields: [commodityId], references: [id])
  mcc       mccs?       @relation(fields: [mccId], references: [id])

  @@index([commodityId])
  @@index([ownerType])
  @@index([mccId])
  @@index([financingStatus])
  @@map("inventory_batches")
}

// Crop Types
model crop_types {
  id                  String             @id @default(cuid())
  name                String
  code                String             @unique
  unitOfMeasure       String // kg, bags, etc.
  qualityStandards    Json? // grading rules
  defaultPricePerUnit Float
  isActive            Boolean            @default(true)
  inventoryProductId  String?            // Product used when receiving this crop type into warehouse
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  collections         crop_collections[]
  inventoryProduct    products?          @relation("CropTypeInventoryProduct", fields: [inventoryProductId], references: [id])

  @@index([code])
  @@index([inventoryProductId])
  @@map("crop_types")
}

// Crop Collections
model crop_collections {
  id              String               @id @default(cuid())
  farmerId        String
  mccId           String
  cropPeriodId    String?
  collectionDate  DateTime
  cropTypeId      String
  quantity        Float
  unit            String // kg, bags, etc.
  qualityTests    Json? // moisture, grade, etc.
  pricePerUnit    Float
  totalAmount     Float
  deductions      Json                 @default("{}")
  advances        Float                @default(0)
  totalDeductions Float                @default(0)
  netPayment      Float                @default(0)
  status          CropCollectionStatus @default(PENDING)
  warehouseId     String?
  locationId      String?
  productId       String?
  stockMoveId     String?
  notes           String?
  agentId        String?   // Umucunda who delivered on behalf of farmer
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  farmer     farmers       @relation(fields: [farmerId], references: [id])
  agent      User?         @relation("CropCollectionAgent", fields: [agentId], references: [id])
  mcc        mccs          @relation(fields: [mccId], references: [id])
  cropType   crop_types    @relation(fields: [cropTypeId], references: [id])
  cropPeriod crop_periods? @relation(fields: [cropPeriodId], references: [id])
  warehouse  Warehouse?    @relation(fields: [warehouseId], references: [id])
  location   Location?     @relation(fields: [locationId], references: [id])
  product    products?     @relation(fields: [productId], references: [id])
  stockMove  StockMove?    @relation(fields: [stockMoveId], references: [id])

  @@index([farmerId])
  @@index([agentId])
  @@index([mccId])
  @@index([collectionDate])
  @@index([status])
  @@index([cropTypeId])
  @@map("crop_collections")
}

// Crop Periods
model crop_periods {
  id              String   @id @default(cuid())
  mccId           String
  periodNumber    Int
  startDate       DateTime
  endDate         DateTime
  totalFarmers    Int      @default(0)
  totalQuantity   Float    @default(0)
  totalAmount     Float    @default(0)
  totalDeductions Float    @default(0)
  totalAdvances   Float    @default(0)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  mcc         mccs               @relation(fields: [mccId], references: [id])
  collections crop_collections[]

  @@index([mccId])
  @@index([periodNumber])
  @@map("crop_periods")
}

// Crop Processing
model crop_processing {
  id                 String   @id @default(cuid())
  mccId              String
  rawCropProductId   String
  processedProductId String
  inputQuantity      Float
  outputQuantity     Float
  processingDate     DateTime
  processingSteps    Json     @default("{}")
  qualityMetrics     Json     @default("{}")
  status             String   @default("PENDING")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  mcc              mccs     @relation(fields: [mccId], references: [id])
  rawProduct       products @relation("CropProcessingRaw", fields: [rawCropProductId], references: [id])
  processedProduct products @relation("CropProcessingProcessed", fields: [processedProductId], references: [id])

  @@index([mccId])
  @@index([rawCropProductId])
  @@index([processedProductId])
  @@map("crop_processing")
}

// Services Catalog
model services {
  id          String      @id @default(cuid())
  name        String
  code        String      @unique
  type        ServiceType
  description String?
  pricing     Json // { type: 'FIXED' | 'HOURLY' | 'USAGE', amount: number }
  duration    Int? // in hours
  sla         Json? // Service Level Agreement
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  deliveries service_deliveries[]

  @@index([code])
  @@index([type])
  @@map("services")
}

// Service Deliveries
model service_deliveries {
  id            String                @id @default(cuid())
  serviceId     String
  farmerId      String?
  mccId         String?
  requestedBy   String
  scheduledDate DateTime
  completedDate DateTime?
  status        ServiceDeliveryStatus @default(SCHEDULED)
  notes         String?
  cost          Float?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  service         services @relation(fields: [serviceId], references: [id])
  farmer          farmers? @relation(fields: [farmerId], references: [id])
  mcc             mccs?    @relation(fields: [mccId], references: [id])
  requestedByUser User     @relation("ServiceRequester", fields: [requestedBy], references: [id])

  @@index([serviceId])
  @@index([farmerId])
  @@index([mccId])
  @@index([status])
  @@index([scheduledDate])
  @@map("service_deliveries")
}

// Reconciliation Records
model reconciliation_records {
  id                 String               @id @default(cuid())
  mccId              String
  periodId           String?
  reconciliationDate DateTime             @default(now())
  type               ReconciliationType
  status             ReconciliationStatus @default(PENDING)
  totalExpected      Float
  totalActual        Float
  discrepancy        Float
  discrepancies      Json? // Array of discrepancy details
  resolvedBy         String?
  resolvedAt         DateTime?
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  mcc            mccs  @relation(fields: [mccId], references: [id])
  resolvedByUser User? @relation("ReconciliationResolver", fields: [resolvedBy], references: [id])

  @@index([mccId])
  @@index([type])
  @@index([status])
  @@index([reconciliationDate])
  @@map("reconciliation_records")
}

// Agent Prepayments/Advances
model agent_prepayments {
  id           String    @id @default(cuid())
  farmerId     String
  agentId      String // User ID of the agent
  commodityId  String? // Optional: link to specific commodity
  batchId      String? // Optional: link to specific batch
  collectionId String? // Optional: link to specific collection when settled
  amount       Float // Advance amount
  currency     String    @default("RWF")
  status       String    @default("PENDING") // PENDING, SETTLED, CANCELLED
  settlementId String? // Link to payment/settlement when settled
  notes        String?
  recordedAt   DateTime  @default(now())
  settledAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  farmer     farmers                  @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  agent      User                     @relation("AgentPrepayments", fields: [agentId], references: [id], onDelete: Cascade)
  commodity  commodities?             @relation(fields: [commodityId], references: [id], onDelete: SetNull)
  batch      bulk_batches?            @relation(fields: [batchId], references: [id], onDelete: SetNull)
  collection commodity_collections?   @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  auditLogs  agent_prepayment_audit[]

  @@index([farmerId])
  @@index([agentId])
  @@index([commodityId])
  @@index([batchId])
  @@index([collectionId])
  @@index([status])
  @@index([recordedAt])
  @@map("agent_prepayments")
}

// Audit Trail for Agent Prepayments
model agent_prepayment_audit {
  id           String   @id @default(cuid())
  prepaymentId String
  action       String // CREATED, SETTLED, CANCELLED, UPDATED
  performedBy  String // User ID
  oldValue     Json? // Previous state
  newValue     Json? // New state
  notes        String?
  createdAt    DateTime @default(now())

  prepayment agent_prepayments @relation(fields: [prepaymentId], references: [id], onDelete: Cascade)
  performer  User              @relation("AgentPrepaymentAuditPerformer", fields: [performedBy], references: [id])

  @@index([prepaymentId])
  @@index([performedBy])
  @@index([action])
  @@index([createdAt])
  @@map("agent_prepayment_audit")
}

// Farmer-Agent Assignments (Many-to-Many)
model farmer_agent_assignments {
  id         String   @id @default(cuid())
  farmerId   String
  agentId    String // User ID of the agent
  assignedAt DateTime @default(now())
  assignedBy String? // User ID who made the assignment
  isActive   Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  farmer         farmers @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  agent          User    @relation("FarmerAgentAssignments", fields: [agentId], references: [id], onDelete: Cascade)
  assignedByUser User?   @relation("FarmerAgentAssignmentCreator", fields: [assignedBy], references: [id])

  @@unique([farmerId, agentId])
  @@index([farmerId])
  @@index([agentId])
  @@index([isActive])
  @@map("farmer_agent_assignments")
}

// Rwanda Administrative Divisions (official hierarchy: Province -> District -> Sector -> Cell -> Village)
model rwanda_province {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. East, Kigali, North, South, West
  slug      String   @unique // lowercase e.g. east, kigali
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  districts rwanda_district[]

  @@map("rwanda_provinces")
}

model rwanda_district {
  id         String   @id @default(cuid())
  name       String
  slug       String   // lowercase, unique within province
  provinceId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  province rwanda_province @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  sectors  rwanda_sector[]

  @@unique([provinceId, slug])
  @@index([provinceId])
  @@map("rwanda_districts")
}

model rwanda_sector {
  id         String   @id @default(cuid())
  name       String
  slug       String
  districtId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  district rwanda_district @relation(fields: [districtId], references: [id], onDelete: Cascade)
  cells    rwanda_cell[]

  @@unique([districtId, slug])
  @@index([districtId])
  @@map("rwanda_sectors")
}

model rwanda_cell {
  id        String   @id @default(cuid())
  name      String
  slug      String
  sectorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sector   rwanda_sector  @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  villages rwanda_village[]

  @@unique([sectorId, slug])
  @@index([sectorId])
  @@map("rwanda_cells")
}

model rwanda_village {
  id       String   @id @default(cuid())
  name     String
  slug     String
  cellId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cell rwanda_cell @relation(fields: [cellId], references: [id], onDelete: Cascade)

  @@unique([cellId, slug])
  @@index([cellId])
  @@map("rwanda_villages")
}

// ============================================
// TRAINING MODULE (Standalone Learning Portal)
// ============================================
// Lightweight learning portal for farmers, agents, warehouse staff, quality officers.
// Content stored externally (S3/R2/Supabase); progress and certifications in DB.

enum TrainingTargetRole {
  Farmer
  Agent
  QualityOfficer
  WarehouseOfficer
}

enum TrainingDifficultyLevel {
  Beginner
  Intermediate
  Advanced
}

enum TrainingLessonContentType {
  video
  pdf
  text
  image
}

model TrainingModule {
  id              String                   @id @default(cuid())
  title           String
  description     String?
  commodityId     String?                  // Optional: link to commodity for role/commodity-based recommendations
  targetRole      TrainingTargetRole       // Farmer | Agent | QualityOfficer | WarehouseOfficer
  durationMinutes Int                      @default(0)
  difficultyLevel TrainingDifficultyLevel  @default(Beginner)
  isActive        Boolean                  @default(true)
  isPublic        Boolean                  @default(false) // When true, viewable without auth at /trainings/library
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  commodity  commodities?            @relation(fields: [commodityId], references: [id], onDelete: SetNull)
  lessons    TrainingLesson[]
  progress   UserTrainingProgress[]
  certifications UserCertification[]

  @@index([commodityId])
  @@index([targetRole])
  @@index([isActive])
  @@index([isPublic])
  @@map("training_modules")
}

model TrainingLesson {
  id              String                   @id @default(cuid())
  moduleId        String
  title           String
  description     String?
  contentType     TrainingLessonContentType // video | pdf | text | image
  contentUrl      String?                  // External URL (S3, R2, Supabase storage)
  orderIndex      Int                      @default(0)
  durationMinutes Int                      @default(0)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  module   TrainingModule          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress UserTrainingProgress[]

  @@index([moduleId])
  @@index([orderIndex])
  @@map("training_lessons")
}

// Progress: completed lessons per user per module. Progress % = completed lessons / total lessons.
model UserTrainingProgress {
  id          String    @id @default(cuid())
  userId      String
  moduleId    String
  lessonId    String
  completedAt DateTime  @default(now())

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  module TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lesson TrainingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId, lessonId])
  @@index([userId])
  @@index([moduleId])
  @@map("user_training_progress")
}

// Certifications are immutable. Certificate number format: GEMURA-CERT-YYYY-NNNNN
model UserCertification {
  id                 String    @id @default(cuid())
  userId             String
  moduleId          String
  certificationDate  DateTime  @default(now())
  expiryDate         DateTime?
  certificateNumber  String    @unique

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  module TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([moduleId])
  @@index([certificateNumber])
  @@map("user_certifications")
}

// ============================================
// SOROMA FOODS: Multi-Tenant Agroprocessor OS
// ============================================

enum SoromaWorkspaceType {
  PLATFORM
  TENANT
}

enum SoromaTenantStatus {
  ACTIVE
  SUSPENDED
  ONBOARDING
  INACTIVE
}

enum SoromaSupplierType {
  COOPERATIVE
  SMALLHOLDER_GROUP
  COMPANY
  INDIVIDUAL
}

enum SoromaPOStatus {
  REQUESTED
  RFQ_SENT
  AWAITING_APPROVAL
  APPROVED
  PARTIALLY_RECEIVED
  CLOSED
  CANCELLED
}

enum SoromaBatchStatus {
  PLANNED
  STARTED
  IN_PROGRESS
  QC_REVIEW
  COMPLETED
  ARCHIVED
  ON_HOLD
  CANCELLED
}

enum SoromaOrderStatus {
  DRAFT
  QUOTED
  CONFIRMED
  IN_FULFILLMENT
  SHIPPED
  DELIVERED
  CANCELLED
}

enum SoromaShipmentStatus {
  PLANNED
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  POD_RECEIVED
  CLOSED
  DELAYED
  CANCELLED
}

enum SoromaPassportStatus {
  DRAFT
  ISSUED
  REVOKED
  RECALLED
}

enum SoromaAlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SoromaAlertStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SoromaConnectorStatus {
  CONNECTED
  PARTIAL
  DOWN
  PENDING
}

enum SoromaOnboardingStage {
  APPLICATION_RECEIVED
  UNDER_REVIEW
  ASSESSMENT
  SETUP
  COMPLETED
  REJECTED
}

model SoromaTenant {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  logo             String?
  country          String             @default("RW")
  currency         String             @default("RWF")
  timezone         String             @default("Africa/Kigali")
  valueChain       String?
  status           SoromaTenantStatus @default(ONBOARDING)
  onboardingStage  SoromaOnboardingStage @default(APPLICATION_RECEIVED)
  complianceScore  Float?
  district         String?
  region           String?
  contactEmail     String?
  contactPhone     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  memberships      SoromaTenantMembership[]
  suppliers        SoromaSupplier[]
  purchaseOrders   SoromaPurchaseOrder[]
  batches          SoromaProductionBatch[]
  warehouses       SoromaWarehouse[]
  stockLots        SoromaStockLot[]
  buyers           SoromaBuyer[]
  orders           SoromaOrder[]
  shipments        SoromaShipment[]
  passports        SoromaPassport[]
  certifications   SoromaCertification[]
  audits           SoromaAudit[]
  capas            SoromaCAPA[]
  qcTests          SoromaQCTest[]
  connections      SoromaTenantConnection[]
  alerts           SoromaAlert[]
  auditLogs        SoromaAuditLog[]
  financeRecords   SoromaFinanceRecord[]
  exportJobs       SoromaExportJob[]
  reportSchedules  SoromaReportSchedule[]

  @@index([status])
  @@index([country])
  @@map("soroma_tenants")
}

model SoromaTenantMembership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      String // TENANT_ADMIN, SUPPLIER_MANAGER, etc.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant SoromaTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@map("soroma_tenant_memberships")
}

model SoromaPlatformMembership {
  id        String   @id @default(cuid())
  userId    String   @unique
  role      String // PLATFORM_OPERATOR, PLATFORM_SUPER_ADMIN, etc.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("soroma_platform_memberships")
}

model SoromaSupplier {
  id               String             @id @default(cuid())
  tenantId         String
  name             String
  type             SoromaSupplierType @default(COMPANY)
  commodity        String?
  district         String?
  contactPhone     String?
  contactEmail     String?
  qualityScore     Float?
  complianceStatus String             @default("PENDING")
  status           String             @default("PENDING") // PENDING, ACTIVE, SUSPENDED
  gpsLatitude      Float?
  gpsLongitude     Float?
  metadata         Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  tenant         SoromaTenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders SoromaPurchaseOrder[]
  rawMaterialLots SoromaRawMaterialLot[]
  issues         SoromaSupplierIssue[]

  @@index([tenantId])
  @@index([status])
  @@map("soroma_suppliers")
}

model SoromaSupplierIssue {
  id         String   @id @default(cuid())
  tenantId   String
  supplierId String
  title      String
  severity   SoromaAlertSeverity @default(MEDIUM)
  status     SoromaAlertStatus   @default(OPEN)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supplier SoromaSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([supplierId])
  @@map("soroma_supplier_issues")
}

model SoromaPurchaseOrder {
  id           String         @id @default(cuid())
  tenantId     String
  supplierId   String
  poNumber     String
  commodity    String?
  orderDate    DateTime       @default(now())
  deliveryDate DateTime?
  amount       Decimal        @default(0) @db.Decimal(18, 2)
  currency     String         @default("RWF")
  status       SoromaPOStatus @default(REQUESTED)
  notes        String?
  createdById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant   SoromaTenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier SoromaSupplier      @relation(fields: [supplierId], references: [id])
  lines    SoromaPurchaseOrderLine[]
  receipts SoromaRawMaterialLot[]

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@index([status])
  @@map("soroma_purchase_orders")
}

model SoromaPurchaseOrderLine {
  id              String  @id @default(cuid())
  purchaseOrderId String
  description     String
  quantity        Float
  unit            String  @default("kg")
  unitPrice       Decimal @default(0) @db.Decimal(18, 2)
  lineTotal       Decimal @default(0) @db.Decimal(18, 2)

  purchaseOrder SoromaPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("soroma_purchase_order_lines")
}

model SoromaRawMaterialLot {
  id              String   @id @default(cuid())
  tenantId        String
  supplierId      String?
  purchaseOrderId String?
  lotNumber       String
  commodity       String?
  quantity        Float
  unit            String   @default("kg")
  receivedAt      DateTime @default(now())
  expiryDate      DateTime?
  qcStatus        String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplier      SoromaSupplier?      @relation(fields: [supplierId], references: [id])
  purchaseOrder SoromaPurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  batchInputs   SoromaBatchMaterialInput[]

  @@unique([tenantId, lotNumber])
  @@index([tenantId])
  @@map("soroma_raw_material_lots")
}

model SoromaProductionLine {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches SoromaProductionBatch[]

  @@index([tenantId])
  @@map("soroma_production_lines")
}

model SoromaProductionBatch {
  id           String            @id @default(cuid())
  tenantId     String
  batchNumber  String
  productName  String?
  lineId       String?
  status       SoromaBatchStatus @default(PLANNED)
  startedAt    DateTime?
  completedAt  DateTime?
  outputQty    Float?
  expectedQty  Float?
  yieldPct     Float?
  wastagePct   Float?
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  tenant     SoromaTenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  line       SoromaProductionLine?   @relation(fields: [lineId], references: [id])
  inputs     SoromaBatchMaterialInput[]
  outputs    SoromaFinishedSkuLot[] @relation("BatchOutputs")
  stockLots  SoromaStockLot[]
  downtime   SoromaDowntimeEvent[]
  qcExceptions SoromaQCException[]
  passports  SoromaPassport[]

  @@unique([tenantId, batchNumber])
  @@index([tenantId])
  @@index([status])
  @@map("soroma_production_batches")
}

model SoromaBatchMaterialInput {
  id              String @id @default(cuid())
  batchId         String
  rawMaterialLotId String
  quantityUsed    Float

  batch          SoromaProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
