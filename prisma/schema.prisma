generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                            String                     @id @default(cuid())
  displayId                     String?                    @unique // Format: COUNTRY-YEAR-SEQ e.g. RW-2026-00001 (immutable, unique, not PK)
  email                         String                     @unique
  phone                         String?                    @unique
  name                          String
  password                      String
  avatar                        String?
  isActive                      Boolean                    @default(true)
  createdAt                     DateTime                   @default(now())
  updatedAt                     DateTime                   @updatedAt
  mccId                         String?
  ddin_username                 String?
  ddin_password                 String?
  mvend_wallet_id               String?
  mvend_linked_msisdn           String?
  mvend_member_id               String?
  national_id                   String?
  gender                        String?
  district                      String?
  dateOfBirth                   DateTime?
  country                       String?
  city                          String?
  address                       String?
  postalCode                    String?
  languagePreference            String?
  alternatePhone                String?
  // Organization registration (optional): COOPERATIVE | COMPANY | NGO
  organizationType               String?
  businessName                  String?
  tin                           String?
  businessSize                  String?
  contactPerson                 String?
  pharmacyId                    String?
  // Geo-location fields (for agents/field agents)
  gpsLatitude                   Float?
  gpsLongitude                  Float?
  geoConsent                    Boolean                    @default(false)
  geoConsentAt                  DateTime?
  geoCreatedAt                  DateTime?
  geoUpdatedAt                  DateTime?
  evaluations                   ApplicationEvaluation[]
  managedPharmacy               Pharmacy?                  @relation("PharmacyPharmacist")
  dispensedPrescriptions        Prescription[]
  approvedStockOrders           StockOrder[]               @relation("ApprovedStockOrders")
  completedStockOrders          StockOrder[]               @relation("CompletedStockOrders")
  requestedStockOrders          StockOrder[]               @relation("RequestedStockOrders")
  paymentConfirmedStockOrders   StockOrder[]               @relation("PaymentConfirmedStockOrders")
  rejectedStockOrders           StockOrder[]               @relation("RejectedStockOrders")
  interviewsConducted           ApplicationInterview[]     @relation("Interviewer")
  applications                  Application[]
  completedCycleCounts          CycleCount[]               @relation("CompletedCycleCounts")
  createdCycleCounts            CycleCount[]               @relation("CreatedCycleCounts")
  dccProfile                    DCCProfile?
  dccStocks                     DCCStock[]
  approvedInventoryAdjustments  InventoryAdjustment[]      @relation("ApprovedInventoryAdjustments")
  createdInventoryAdjustments   InventoryAdjustment[]      @relation("CreatedInventoryAdjustments")
  products                      products[]
  createdStockMoves             StockMove[]                @relation("CreatedStockMoves")
  processedStockMoves           StockMove[]                @relation("ProcessedStockMoves")
  roleAssignments               UserRoleAssignment[]       @relation("RoleAssignments")
  userRole                      UserRoleAssignment?
  mcc                           mccs?                      @relation(fields: [mccId], references: [id])
  managedMcc                    mccs?                      @relation("MCCManager")
  pharmacy                      Pharmacy?                  @relation("PharmacyUsers", fields: [pharmacyId], references: [id])
  wallet                        Wallet?
  processedWithdrawals          WithdrawalRequest[]        @relation("ProcessedWithdrawals")
  withdrawalRequests            WithdrawalRequest[]
  milkCollectionsAsAgent        milk_collections[]         @relation("MilkCollectionAgent")
  staff                         staff?
  capacityAssessments           capacity_assessments[]     @relation("CapacityAssessor")
  sales                         sales[]                    @relation("SalesAgent")
  questionnaireResponses        questionnaire_responses[]  @relation("QuestionnaireRespondent")
  rentalSigner                  rentals[]                  @relation("RentalSigner")
  serviceRequester              service_deliveries[]       @relation("ServiceRequester")
  reconciliationResolver        reconciliation_records[]   @relation("ReconciliationResolver")
  commodityCollectionAgent      commodity_collections[]    @relation("CommodityCollectionAgent")
  cropCollectionsAsAgent        crop_collections[]         @relation("CropCollectionAgent")
  idVerifier                    id_verifications[]         @relation("IDVerifier")
  farmerAgentAssignments        farmer_agent_assignments[] @relation("FarmerAgentAssignments")
  farmerAgentAssignmentCreator  farmer_agent_assignments[] @relation("FarmerAgentAssignmentCreator")
  agentPrepayments              agent_prepayments[]        @relation("AgentPrepayments")
  agentPrepaymentAuditPerformer agent_prepayment_audit[]   @relation("AgentPrepaymentAuditPerformer")
  userTrainingProgress         UserTrainingProgress[]
  userCertifications           UserCertification[]
  availabilitySignalsCreated   pre_collection_availability_signals[] @relation("AvailabilitySignalsCreated")
  soromaTenantMemberships      SoromaTenantMembership[]
  soromaPlatformMembership   SoromaPlatformMembership?

  @@index([mccId])
  @@index([pharmacyId])
  @@map("users")
}

model Application {
  id          String                  @id
  userId      String?
  phone       String
  email       String?
  status      ApplicationStatus       @default(SUBMITTED)
  formData    Json
  currentStep Int                     @default(1)
  notes       String?
  dccCreated  Boolean                 @default(false)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  nationalId  String?                 @unique
  evaluations ApplicationEvaluation[]
  interviews  ApplicationInterview[]
  user        User?                   @relation(fields: [userId], references: [id])
  dccProfile  DCCProfile?

  @@index([userId])
  @@map("applications")
}

model ApplicationEvaluation {
  id              String      @id @default(cuid())
  applicationId   String
  type            String      @default("VULNERABILITY")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  overallLevel    String?
  recommendations Json?
  scores          Json?
  totalScore      Float
  evaluatorId     String
  metadata        Json?
  questionScores  Json?
  score           Float
  application     Application @relation(fields: [applicationId], references: [id])
  evaluator       User        @relation(fields: [evaluatorId], references: [id])

  @@index([applicationId])
  @@index([evaluatorId])
}

model DCCProfile {
  id                String      @id @default(cuid())
  userId            String      @unique
  applicationId     String      @unique
  level             DCCLevel    @default(LEVEL_C)
  rating            Float       @default(5.0)
  totalSales        String      @default("RWF 0")
  monthlySales      String      @default("RWF 0")
  productsAvailable Int         @default(0)
  status            String      @default("active")
  location          String
  specialties       String[]
  performance       Json
  recentActivity    Json
  approvedBy        String?
  approvedDate      DateTime    @default(now())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  application       Application @relation(fields: [applicationId], references: [id])
  user              User        @relation(fields: [userId], references: [id])
  wallet            DCCWallet?

  @@map("dcc_profiles")
}

model EmailLog {
  id        String    @id @default(cuid())
  to        String
  subject   String
  template  String
  status    String
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("email_logs")
}

model SMSLog {
  id        String    @id @default(cuid())
  to        String
  message   String
  status    String
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("sms_logs")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model PasswordReset {
  id         String    @id @default(cuid())
  email      String
  token      String    @unique
  used       Boolean   @default(false)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  metadata   String?
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  @@index([expiresAt], map: "password_resets_expires_at_idx")
  @@index([metadata])
  @@index([used])
  @@map("password_resets")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())

  @@map("sessions")
}

model Job {
  id           String   @id @default(cuid())
  title        String
  description  String
  company      String
  location     String
  salary       String?
  type         String
  category     String
  requirements Json
  benefits     Json?
  isActive     Boolean  @default(true)
  postedBy     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("jobs")
}

model Employer {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  phone       String?
  location    String?
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("employers")
}

model Brand {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  logo        String?
  website     String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  products    products[]

  @@map("brands")
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  sku        String   @unique
  color      String?
  size       String?
  model      String?
  weight     Float?
  dimensions Json?
  stock      Int      @default(0)
  price      Float
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    products @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

model ProductSpecification {
  id        String   @id @default(cuid())
  productId String
  name      String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   products @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_specifications")
}

model ProductReview {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  title     String?
  comment   String?
  verified  Boolean  @default(false)
  helpful   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   products @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_reviews")
}

model OrderItem {
  id        String   @id @default(cuid())
  productId String
  quantity  Int
  price     Float
  total     Float
  product   products @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String
  instructor  String
  duration    String
  level       String
  category    String
  price       Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("courses")
}

model DCCWallet {
  id                 String              @id @default(cuid())
  dccProfileId       String              @unique
  balance            Float               @default(0)
  minimumBalance     Float               @default(5000)
  lastWithdrawal     DateTime?
  status             String              @default("active")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  dccProfile         DCCProfile          @relation(fields: [dccProfileId], references: [id])
  transactions       WalletTransaction[]
  withdrawalRequests WithdrawalRequest[]

  @@map("dcc_wallets")
}

model WalletTransaction {
  id          String            @id @default(cuid())
  walletId    String
  type        TransactionType
  amount      Float
  description String
  status      TransactionStatus @default(COMPLETED)
  reference   String?
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  wallet      DCCWallet         @relation(fields: [walletId], references: [id])

  @@map("wallet_transactions")
}

model WithdrawalRequest {
  id            String           @id @default(cuid())
  walletId      String
  amount        Float
  status        WithdrawalStatus @default(PENDING)
  reason        String?
  reviewedBy    String?
  reviewedAt    DateTime?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  userId        String
  adminComment  String?
  processedAt   DateTime?
  processedById String?
  processedBy   User?            @relation("ProcessedWithdrawals", fields: [processedById], references: [id])
  user          User             @relation(fields: [userId], references: [id])
  wallet        DCCWallet        @relation(fields: [walletId], references: [id])

  @@map("withdrawal_requests")
}

model Wallet {
  id             String        @id @default(cuid())
  userId         String        @unique
  balance        Float         @default(0)
  minimumBalance Float         @default(1000)
  lastWithdrawal DateTime?
  status         String        @default("ACTIVE")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  transactions   Transaction[]
  user           User          @relation(fields: [userId], references: [id])

  @@map("wallets")
}

model Transaction {
  id          String   @id @default(cuid())
  walletId    String
  type        String
  amount      Float
  status      String   @default("PENDING")
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  wallet      Wallet   @relation(fields: [walletId], references: [id])

  @@map("transactions")
}

model StockOrder {
  id                     String              @id @default(cuid())
  dccId                  String
  totalAmount            Float
  status                 String
  priority               String
  requestDate            DateTime            @default(now())
  estimatedDelivery      DateTime?
  notes                  String?
  approvedBy             String?
  approvedAt             DateTime?
  rejectedBy             String?
  rejectedAt             DateTime?
  paymentConfirmedBy     String?
  paymentConfirmedAt     DateTime?
  completedBy            String?
  completedAt            DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  payment                Payment?
  approvedByUser         User?               @relation("ApprovedStockOrders", fields: [approvedBy], references: [id])
  completedByUser        User?               @relation("CompletedStockOrders", fields: [completedBy], references: [id])
  dcc                    User                @relation("RequestedStockOrders", fields: [dccId], references: [id])
  paymentConfirmedByUser User?               @relation("PaymentConfirmedStockOrders", fields: [paymentConfirmedBy], references: [id])
  rejectedByUser         User?               @relation("RejectedStockOrders", fields: [rejectedBy], references: [id])
  products               StockOrderProduct[]

  @@index([dccId])
  @@index([status])
  @@index([priority])
}

model StockOrderProduct {
  id             String     @id @default(cuid())
  stockOrderId   String
  productId      String
  quantity       Int
  currentStock   Int
  requestedStock Int
  price          Float
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  product        products   @relation(fields: [productId], references: [id])
  stockOrder     StockOrder @relation(fields: [stockOrderId], references: [id])

  @@index([stockOrderId])
  @@index([productId])
}

model Payment {
  id           String     @id @default(cuid())
  stockOrderId String     @unique
  status       String
  amount       Float
  method       String?
  reference    String?
  paidAt       DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  stockOrder   StockOrder @relation(fields: [stockOrderId], references: [id])

  @@index([status])
}

model DCCStock {
  id        String   @id @default(cuid())
  dccId     String
  productId String
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dcc       User     @relation(fields: [dccId], references: [id])
  product   products @relation(fields: [productId], references: [id])

  @@unique([dccId, productId])
  @@map("dcc_stocks")
}

model FormConfig {
  id          String   @id @default(cuid())
  title       String
  description String
  sections    Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("form_configs")
}

model DCC {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String   @unique
  location  String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dccs")
}

model Warehouse {
  id                    String                  @id @default(cuid())
  name                  String
  code                  String                  @unique
  description           String?
  address               String?
  city                  String?
  country               String?
  isActive              Boolean                 @default(true)
  isMain                Boolean                 @default(false)
  mccId                 String?                 // When set, this warehouse belongs to that MCC (each MCC has its own global warehouses)
  // Geo-location fields
  gpsLatitude           Float?
  gpsLongitude          Float?
  geoConsent            Boolean                 @default(false)
  geoConsentAt          DateTime?
  geoCreatedAt          DateTime?
  geoUpdatedAt          DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  mccs                  mccs?                   @relation(fields: [mccId], references: [id], onDelete: SetNull)
  cycleCounts           CycleCount[]
  inventoryAdjustments  InventoryAdjustment[]
  locations             Location[]
  lotNumbers            LotNumber[]
  milk_collections      milk_collections[]
  crop_collections      crop_collections[]
  commodity_collections commodity_collections[]
  reorderRules          ReorderRule[]
  serialNumbers         SerialNumber[]
  stockMoves            StockMove[]
  stockQuantities       StockQuantity[]
  mccWarehouses         mcc_warehouses[]

  @@index([mccId])
  @@map("warehouses")
}

model Location {
  id                    String                  @id @default(cuid())
  name                  String
  code                  String
  description           String?
  warehouseId           String
  parentId              String?
  locationType          LocationType            @default(STORAGE)
  isActive              Boolean                 @default(true)
  maxCapacity           Int?
  currentCapacity       Int?                    @default(0)
  barcode               String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  cycleCounts           CycleCount[]
  inventoryAdjustments  InventoryAdjustment[]
  parent                Location?               @relation("LocationHierarchy", fields: [parentId], references: [id])
  children              Location[]              @relation("LocationHierarchy")
  warehouse             Warehouse               @relation(fields: [warehouseId], references: [id])
  lotNumbers            LotNumber[]
  milk_collections      milk_collections[]
  crop_collections      crop_collections[]
  commodity_collections commodity_collections[]
  reorderRules          ReorderRule[]
  serialNumbers         SerialNumber[]
  destinationStockMoves StockMove[]             @relation("DestinationLocation")
  stockMoves            StockMove[]             @relation("SourceLocation")
  stockQuantities       StockQuantity[]

  @@unique([warehouseId, code])
  @@map("locations")
}

model StockMove {
  id                    String                  @id @default(cuid())
  productId             String
  warehouseId           String?
  locationId            String?
  destinationLocationId String?
  quantity              Float
  unitPrice             Float?
  moveType              StockMoveType
  state                 StockMoveState          @default(DRAFT)
  priority              String                  @default("normal")
  scheduledDate         DateTime?
  date                  DateTime                @default(now())
  origin                String?
  reference             String?
  notes                 String?
  createdBy             String
  processedBy           String?
  processedAt           DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  milk_collections      milk_collections[]
  crop_collections      crop_collections[]
  commodity_collections commodity_collections[]
  createdByUser         User                    @relation("CreatedStockMoves", fields: [createdBy], references: [id])
  destinationLocation   Location?               @relation("DestinationLocation", fields: [destinationLocationId], references: [id])
  location              Location?               @relation("SourceLocation", fields: [locationId], references: [id])
  processedByUser       User?                   @relation("ProcessedStockMoves", fields: [processedBy], references: [id])
  product               products                @relation(fields: [productId], references: [id])
  warehouse             Warehouse?              @relation(fields: [warehouseId], references: [id])

  @@index([productId])
  @@index([state])
  @@index([moveType])
  @@index([date])
  @@map("stock_moves")
}

model StockQuantity {
  id                String     @id @default(cuid())
  productId         String
  warehouseId       String?
  locationId        String?
  quantity          Float      @default(0)
  reservedQuantity  Float      @default(0)
  availableQuantity Float      @default(0)
  lastUpdated       DateTime   @default(now())
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  location          Location?  @relation(fields: [locationId], references: [id])
  product           products   @relation(fields: [productId], references: [id])
  warehouse         Warehouse? @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId, locationId])
  @@index([productId])
  @@map("stock_quantities")
}

model InventoryAdjustment {
  id             String                   @id @default(cuid())
  productId      String
  warehouseId    String?
  locationId     String?
  quantity       Float
  adjustmentType InventoryAdjustmentType
  reason         String
  notes          String?
  state          InventoryAdjustmentState @default(DRAFT)
  createdBy      String
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  approvedByUser User?                    @relation("ApprovedInventoryAdjustments", fields: [approvedBy], references: [id])
  createdByUser  User                     @relation("CreatedInventoryAdjustments", fields: [createdBy], references: [id])
  location       Location?                @relation(fields: [locationId], references: [id])
  product        products                 @relation(fields: [productId], references: [id])
  warehouse      Warehouse?               @relation(fields: [warehouseId], references: [id])

  @@index([productId])
  @@index([state])
  @@map("inventory_adjustments")
}

model LotNumber {
  id          String     @id @default(cuid())
  productId   String
  lotNumber   String
  expiryDate  DateTime?
  quantity    Float      @default(0)
  warehouseId String?
  locationId  String?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  location    Location?  @relation(fields: [locationId], references: [id])
  product     products   @relation(fields: [productId], references: [id])
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  @@unique([productId, lotNumber])
  @@index([productId])
  @@index([expiryDate])
  @@map("lot_numbers")
}

model SerialNumber {
  id           String             @id @default(cuid())
  productId    String
  serialNumber String             @unique
  warehouseId  String?
  locationId   String?
  status       SerialNumberStatus @default(AVAILABLE)
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  location     Location?          @relation(fields: [locationId], references: [id])
  product      products           @relation(fields: [productId], references: [id])
  warehouse    Warehouse?         @relation(fields: [warehouseId], references: [id])

  @@index([productId])
  @@index([status])
  @@map("serial_numbers")
}

model CycleCount {
  id              String           @id @default(cuid())
  name            String
  warehouseId     String?
  locationId      String?
  productId       String?
  state           CycleCountState  @default(DRAFT)
  scheduledDate   DateTime?
  completedAt     DateTime?
  createdBy       String
  completedBy     String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  items           CycleCountItem[]
  completedByUser User?            @relation("CompletedCycleCounts", fields: [completedBy], references: [id])
  createdByUser   User             @relation("CreatedCycleCounts", fields: [createdBy], references: [id])
  location        Location?        @relation(fields: [locationId], references: [id])
  product         products?        @relation(fields: [productId], references: [id])
  warehouse       Warehouse?       @relation(fields: [warehouseId], references: [id])

  @@index([state])
  @@map("cycle_counts")
}

model CycleCountItem {
  id               String     @id @default(cuid())
  cycleCountId     String
  productId        String
  expectedQuantity Float
  countedQuantity  Float?
  variance         Float?
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  cycleCount       CycleCount @relation(fields: [cycleCountId], references: [id])
  product          products   @relation(fields: [productId], references: [id])

  @@index([cycleCountId])
  @@map("cycle_count_items")
}

model ReorderRule {
  id            String     @id @default(cuid())
  productId     String
  warehouseId   String?
  locationId    String?
  minQuantity   Float
  maxQuantity   Float?
  orderQuantity Float
  leadTime      Int        @default(7)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  location      Location?  @relation(fields: [locationId], references: [id])
  product       products   @relation(fields: [productId], references: [id])
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId, locationId])
  @@map("reorder_rules")
}

model Packaging {
  id              String     @id @default(cuid())
  name            String
  description     String?
  unitsPerPackage Int?
  weight          Float?
  volume          Float?
  length          Float?
  width           Float?
  height          Float?
