model mcc_payments {
  id               String           @id @default(cuid())
  farmerId         String
  collectionId     String
  mccId            String
  totalAmount      Float
  deductions       Float            @default(0)
  advances         Float            @default(0)
  netPayment       Float
  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus    @default(pending)
  paymentDate      DateTime
  processedBy      String
  notes            String           @default("")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  farmers          farmers          @relation(fields: [farmerId], references: [id])
  milk_collections milk_collections @relation(fields: [collectionId], references: [id])
  mccs             mccs             @relation(fields: [mccId], references: [id])

  @@index([farmerId])
  @@index([collectionId])
  @@index([mccId])
  @@index([paymentDate])
  @@index([paymentStatus])
}

enum PaymentMethod {
  cash
  mobile_money
  bank_transfer
}

// Bulk batches for milk bulking operations
model bulk_batches {
  id                      String             @id @default(cuid())
  mccId                   String
  createdAt               DateTime           @default(now())
  dispatched              Boolean            @default(false)
  dispatchedToProcessorId String?
  totalLiters             Float              @default(0)
  mccs                    mccs               @relation(fields: [mccId], references: [id])
  milk_collections        milk_collections[]

  @@index([mccId])
  @@index([dispatched])
}

// Staff & contracts (workforce)
model staff {
  id             String    @id @default(cuid())
  userId         String?   @unique
  mccId          String?
  position       String?
  employmentType String? // permanent, contract, seasonal
  startDate      DateTime?
  endDate        DateTime?
  trainingLevel  String?
  certifications String[]
  payrollAccount String?
  createdAt      DateTime  @default(now())
  user           User?     @relation(fields: [userId], references: [id])
  mcc            mccs?     @relation(fields: [mccId], references: [id])

  @@index([mccId])
  @@index([userId])
}

// Vehicles & Transport
model vehicles {
  id              String    @id @default(cuid())
  regNo           String    @unique
  vehicleType     String? // pickup, tanker, van
  capacityLiters  Float?
  status          String    @default("available") // available, on_route, maintenance
  lastMaintenance DateTime?
  createdAt       DateTime  @default(now())

  @@index([status])
}

// Generators & Power assets
model power_assets {
  id         String    @id @default(cuid())
  mccId      String
  name       String?
  assetType  String? // generator, solar, inverter
  capacityKw Float?
  lastTested DateTime?
  status     String    @default("operational")
  createdAt  DateTime  @default(now())
  mcc        mccs      @relation(fields: [mccId], references: [id])

  @@index([mccId])
  @@index([status])
}

// Capacity assessments
model capacity_assessments {
  id                         String   @id @default(cuid())
  mccId                      String
  assessedAt                 DateTime @default(now())
  assessorUserId             String?
  staffCount                 Int?
  trainedStaffCount          Int?
  coolingCapacityLiters      Float?
  estimatedDailyDemandLiters Float?
  transportCapacityLiters    Float?
  powerOk                    Boolean?
  notes                      String?
  mcc                        mccs     @relation(fields: [mccId], references: [id])
  assessor                   User?    @relation("CapacityAssessor", fields: [assessorUserId], references: [id])

  @@index([mccId, assessedAt(sort: Desc)])
}

// Suppliers
model suppliers {
  id           String         @id @default(cuid())
  name         String
  phone        String?
  email        String?
  address      String?
  createdAt    DateTime       @default(now())
  procurements procurements[]
}

// Procurements
model procurements {
  id          String              @id @default(cuid())
  supplierId  String
  mccId       String?
  procuredAt  DateTime            @default(now())
  totalAmount Float?
  status      String              @default("received") // ordered, received, cancelled
  supplier    suppliers           @relation(fields: [supplierId], references: [id])
  mcc         mccs?               @relation(fields: [mccId], references: [id])
  items       procurement_items[]

  @@index([mccId])
  @@index([supplierId])
}

// Procurement items
model procurement_items {
  id            String       @id @default(cuid())
  procurementId String
  productId     String
  qty           Float
  unitPrice     Float
  procurement   procurements @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  product       products     @relation(fields: [productId], references: [id])

  @@index([procurementId])
  @@index([productId])
}

// Assets & Rentals
model assets {
  id                String    @id @default(cuid())
  serial            String    @unique
  name              String?
  assetType         String? // tracker, milk_meter, chiller
  status            String    @default("available") // available, rented, maintenance
  currentHolderType String? // farmer, mcc, vendor
  currentHolderId   String?
  purchasedAt       DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  rentals           rentals[]

  @@index([status])
  @@index([assetType])
}

// Rentals
model rentals {
  id            String    @id @default(cuid())
  assetId       String
  farmerId      String?
  mccId         String?
  rentStart     DateTime?
  rentEnd       DateTime?
  rentFeePerDay Float?
  deposit       Float?
  returned      Boolean   @default(false)
  returnedAt    DateTime?
  contractDoc   String?
  createdAt     DateTime  @default(now())
  asset         assets    @relation(fields: [assetId], references: [id])
  farmer        farmers?  @relation(fields: [farmerId], references: [id])
  mcc           mccs?     @relation(fields: [mccId], references: [id])

  @@index([assetId])
  @@index([farmerId])
  @@index([mccId])
}

// Farmer accounts & ledgers
model farmer_accounts {
  id          String   @id @default(cuid())
  farmerId    String   @unique
  balance     Float    @default(0)
  lastUpdated DateTime @default(now())
  farmer      farmers  @relation(fields: [farmerId], references: [id])
}

// Farmer ledger
model farmer_ledger {
  id           String   @id @default(cuid())
  farmerId     String
  entryAt      DateTime @default(now())
  type         String? // COLLECTION, SALE, PAYMENT, ADJUSTMENT
  amount       Float
  balanceAfter Float
  refId        String?
  notes        String?
  farmer       farmers  @relation(fields: [farmerId], references: [id])

  @@index([farmerId, entryAt(sort: Desc)])
}

// Sales (product sales)
model sales {
  id            String       @id @default(cuid())
  mccId         String
  farmerId      String?
  agentId       String?
  saleAt        DateTime     @default(now())
  totalAmount   Float
  paymentMethod String? // CASH, MOMO, CREDIT
  paid          Boolean      @default(false)
  invoiceNo     String?
  mcc           mccs         @relation(fields: [mccId], references: [id])
  farmer        farmers?     @relation(fields: [farmerId], references: [id])
  agent         User?        @relation("SalesAgent", fields: [agentId], references: [id])
  items         sale_items[]

  @@index([mccId])
  @@index([farmerId])
  @@index([saleAt])
}

// Sale items
model sale_items {
  id        String   @id @default(cuid())
  saleId    String
  productId String
  qty       Float
  unitPrice Float
  sale      sales    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   products @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

// Payments (generic)
model payments {
  id        String   @id @default(cuid())
  farmerId  String
  amount    Float
  method    String?  // cash, mobile_money, bank_transfer
  reference String?
  paidAt    DateTime @default(now())
  farmer    farmers  @relation("FarmerPayments", fields: [farmerId], references: [id])

  @@index([farmerId])
  @@index([paidAt])
  @@map("payments")
}

// Questionnaires
model questionnaires {
  id        String                    @id @default(cuid())
  code      String                    @unique
  title     String?
  version   Int                       @default(1)
  schema    Json? // JSON schema to validate responses
  createdAt DateTime                  @default(now())
  responses questionnaire_responses[]
}

// Questionnaire responses
model questionnaire_responses {
  id               String         @id @default(cuid())
  questionnaireId  String
  mccId            String?
  farmerId         String?
  respondentUserId String?
  response         Json?
  submittedAt      DateTime       @default(now())
  questionnaire    questionnaires @relation(fields: [questionnaireId], references: [id])
  mcc              mccs?          @relation(fields: [mccId], references: [id])
  farmer           farmers?       @relation(fields: [farmerId], references: [id])
  respondent       User?          @relation("QuestionnaireRespondent", fields: [respondentUserId], references: [id])

  @@index([questionnaireId])
  @@index([mccId])
  @@index([farmerId])
}
