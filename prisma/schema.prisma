  sideEffects                                                  String[]
  storageConditions                                            Json                   @default("{}")
  strength                                                     String?
  prescriptionItems                                            PrescriptionItem[]
  stockOrderProducts                                           StockOrderProduct[]
  cycleCountItems                                              CycleCountItem[]
  cycleCounts                                                  CycleCount[]
  dccStocks                                                    DCCStock[]
  inventoryAdjustments                                         InventoryAdjustment[]
  lotNumbers                                                   LotNumber[]
