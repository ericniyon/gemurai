          <div className="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/80 to-slate-900/60" />
          <div className="absolute inset-0 bg-gradient-to-r from-slate-950/90 to-transparent" />
        </div>

        {/* Dynamic premium glowing background elements */}
        <div className="absolute top-[-10%] right-[-10%] w-[350px] h-[350px] bg-emerald-500/20 rounded-full blur-[110px] pointer-events-none z-0" />
        <div className="absolute bottom-[-10%] left-[-10%] w-[350px] h-[350px] bg-blue-500/15 rounded-full blur-[110px] pointer-events-none z-0" />

        {/* Brand / Header */}
