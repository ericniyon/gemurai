                                value={form.primaryReason}
                                options={PRIMARY_REASON}
                                onChange={(value) => setForm((prev) => ({ ...prev, primaryReason: value }))}
                                columns="grid-cols-1 sm:grid-cols-2"
                                themeColor="blue"
                              />

                              <VisualGridQuestion
                                label="What action will you perform within 30 days after attending?"
                                value={form.postForumAction}
                                options={POST_FORUM_ACTION}
                                onChange={(value) => setForm((prev) => ({ ...prev, postForumAction: value }))}
                                columns="grid-cols-1 sm:grid-cols-2"
                                themeColor="blue"
                              />

                              <VisualGridQuestion
                                label="How many hours per week can you commit to follow-up activities?"
                                value={form.weeklyCommitment}
                                options={WEEKLY_COMMITMENT}
                                onChange={(value) => setForm((prev) => ({ ...prev, weeklyCommitment: value }))}
                                columns="grid-cols-2 sm:grid-cols-4"
                                themeColor="blue"
                              />

                              <VisualGridQuestion
                                label="What is your connection to Nyagatare?"
                                value={form.nyagatareConnection}
                                options={NYAGATARE_CONNECTION}
                                onChange={(value) => setForm((prev) => ({ ...prev, nyagatareConnection: value }))}
                                columns="grid-cols-1 sm:grid-cols-2"
                                themeColor="blue"
                              />
                            </>
                          )}
                        </motion.div>
                      </AnimatePresence>

                      {/* API and Validation Alert messages */}
                      {statusMessage && (
                        <motion.div
                          initial={{ opacity: 0, y: 10 }}
                          animate={{ opacity: 1, y: 0 }}
                          className={`rounded-xl border p-4 text-sm flex items-start gap-3 ${
                            statusType === "success"
                              ? "border-emerald-200 bg-emerald-50/50 dark:border-emerald-900/30 dark:bg-emerald-950/20 text-emerald-800 dark:text-emerald-400"
                              : "border-red-200 bg-red-50/50 dark:border-red-900/30 dark:bg-red-950/20 text-red-800 dark:text-red-400"
                          }`}
                        >
                          <div className={`p-1 rounded-full flex-shrink-0 ${statusType === "success" ? "bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400" : "bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400"}`}>
                            {statusType === "success" ? <Check className="h-4 w-4 stroke-[3]" /> : <HelpCircle className="h-4 w-4" />}
                          </div>
                          <div>
                            <p className="font-bold">{statusType === "success" ? "Validation Success" : "Error Occurred"}</p>
                            <p className="text-xs text-slate-600 dark:text-slate-400 mt-0.5 leading-relaxed">{statusMessage}</p>
                          </div>
                        </motion.div>
                      )}

                      {/* Bottom Action buttons */}
                      <div className="flex items-center justify-between border-t border-slate-100 dark:border-slate-900 pt-6">
                        <div>
                          {step > 1 && (
                            <Button
                              type="button"
                              variant="outline"
                              onClick={() => {
                                setStep((prev) => (prev > 1 ? ((prev - 1) as 1 | 2 | 3 | 4) : prev))
                                setStatusMessage("")
                                setStatusType("")
                              }}
                              className="border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-900 font-bold px-5 py-2.5 rounded-xl flex items-center gap-2 text-slate-600 dark:text-slate-400 h-11"
                            >
                              <ChevronLeft className="h-4 w-4" /> Back
                            </Button>
                          )}
                        </div>
                        <div className="flex items-center gap-3">
                          {step < 4 ? (
                            <Button
                              type="button"
                              onClick={onNext}
                              className="bg-emerald-500 hover:bg-emerald-600 text-white font-bold px-6 py-2.5 rounded-xl shadow-md transition-all flex items-center gap-2 h-11"
                            >
                              Continue <ChevronRight className="h-4 w-4 stroke-[2.5]" />
                            </Button>
                          ) : (
                            <Button
                              type="submit"
                              disabled={submitting}
                              className="bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold px-8 py-2.5 rounded-xl shadow-lg shadow-emerald-500/10 transition-all flex items-center gap-2 h-11"
                            >
                              {submitting ? (
                                <>
                                  <Loader2 className="h-4 w-4 animate-spin" /> Submitting...
                                </>
                              ) : (
                                <>
                                  Submit Application <Check className="h-4 w-4 stroke-[2.5]" />
                                </>
                              )}
                            </Button>
                          )}
                        </div>
                      </div>
                    </form>
                  </CardContent>
                </Card>
              </div>
            )}
          </AnimatePresence>

        </div>
      </div>
    </div>
  )
}
