function MarketplaceContent() {
  const params = useParams()
  const lang = (params?.lang as string) || "en"
  const t = marketplaceTranslations[lang as keyof typeof marketplaceTranslations] || marketplaceTranslations.en
  const [cart, setCart] = useState<{ [key: string]: number }>({})
  const [searchTerm, setSearchTerm] = useState("")
  const [selectedCategory, setSelectedCategory] = useState("all")
  const [selectedProvider, setSelectedProvider] = useState("all")
  const [priceRange, setPriceRange] = useState({ min: "", max: "" })
  const [sortBy, setSortBy] = useState("featured")
  const [wishlist, setWishlist] = useState<WishlistItem[]>([])
  const [isLoading, setIsLoading] = useState(false)
  const [dccProducts, setDCCProducts] = useState<Product[]>([])
  const [isDCCProductsLoading, setIsDCCProductsLoading] = useState(true)
  const { toast } = useToast()
  const [showProductDialog, setShowProductDialog] = useState(false)
  const [selectedProduct, setSelectedProduct] = useState<Product | null>(null)
  const [quantity, setQuantity] = useState(1)
  const [showCartDialog, setShowCartDialog] = useState(false)
  const [selectedImageIndex, setSelectedImageIndex] = useState(0)

  // Reset quantity when product dialog opens
  useEffect(() => {
    if (showProductDialog) {
      setQuantity(1)
      setSelectedImageIndex(0)
    }
  }, [showProductDialog])

  // Validate quantity when stock changes
  useEffect(() => {
    if (selectedProduct && quantity > selectedProduct.stock) {
      setQuantity(selectedProduct.stock)
    }
  }, [selectedProduct, quantity])

  // Fetch DCC products
  const fetchDCCProducts = async () => {
    try {
      setIsDCCProductsLoading(true)
      const token = localStorage.getItem("DJYH_token")
      const response = await fetch("/api/dcc-products", {
        headers: {
          Authorization: `Bearer ${token}`
        }
      })

      if (!response.ok) {
        throw new Error("Failed to fetch DCC products")
      }

      const data = await response.json()
      if (data.success) {
        setDCCProducts(data.products || [])
      }
    } catch (error) {
      console.error("Error fetching DCC products:", error)
      toast({
        title: "Error",
        description: "Failed to load DCC products",
        variant: "destructive"
      })
    } finally {
      setIsDCCProductsLoading(false)
    }
  }

  useEffect(() => {
    fetchDCCProducts()
  }, [])

  // Filter and sort DCC products
  const filteredDCCProducts = dccProducts.filter(product => {
    const matchesSearch =
      product.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
      product.description.toLowerCase().includes(searchTerm.toLowerCase())
    const matchesCategory = selectedCategory === "all" || product.category === selectedCategory
    const matchesProvider = selectedProvider === "all" || product.provider === selectedProvider
    const matchesPrice =
      (!priceRange.min || product.price >= Number.parseInt(priceRange.min)) &&
      (!priceRange.max || product.price <= Number.parseInt(priceRange.max))
    return matchesSearch && matchesCategory && matchesProvider && matchesPrice
  })

  const sortedDCCProducts = [...filteredDCCProducts].sort((a, b) => {
    switch (sortBy) {
      case "price-low":
        return a.price - b.price
      case "price-high":
        return b.price - a.price
      case "rating":
        return (b.rating || 0) - (a.rating || 0)
      case "newest":
        return (b.isNew ? 1 : 0) - (a.isNew ? 1 : 0)
      default: // featured
        return 0
    }
  })

  const addToCart = async (productId: string, quantity: number = 1) => {
    setIsLoading(true)
    try {
      const product = dccProducts.find((p) => p.id === productId)
      if (!product) {
        throw new Error("Product not found")
      }

      if (product.stock < quantity) {
        toast({
          title: "Error",
          description: "Not enough stock available",
          variant: "destructive",
        })
        return
      }

      setCart((prev) => {
        const currentQuantity = prev[productId] || 0
        const newQuantity = currentQuantity + quantity

        if (newQuantity > product.stock) {
          toast({
            title: "Warning",
            description: "Cannot add more items than available in stock",
            variant: "destructive",
          })
          return prev
        }

        return {
          ...prev,
          [productId]: newQuantity,
        }
      })

      toast({
        title: t.cart.added.title,
        description: (
          <div className="flex items-center gap-2">
            <div className="relative w-8 h-8 rounded overflow-hidden">
              <Image
                src={product.image || "/img/Cooking_Oil_Vegetable.png"}
                alt={product.name}
                fill
                className="object-cover"
                onError={(e) => {
                  const target = e.target as HTMLImageElement;
                  target.src = "/img/Cooking_Oil_Vegetable.png";
                }}
              />
            </div>
            <div>
              <p className="font-medium">{quantity}x {product.name}</p>
              <p className="text-sm text-gray-500">Added to cart</p>
            </div>
          </div>
        ),
      })
    } catch (error) {
      toast({
        title: t.cart.error.title,
        description: t.cart.error.description,
        variant: "destructive",
      })
    } finally {
      setIsLoading(false)
    }
  }

  const toggleWishlist = async (productId: string) => {
    try {
      const product = dccProducts.find((p) => p.id === productId)
      if (!product) {
        throw new Error("Product not found")
      }

      const isInWishlist = wishlist.some(item => item.productId === productId)
      if (isInWishlist) {
        setWishlist(prev => prev.filter(item => item.productId !== productId))
        
        // Save to localStorage
        const updatedWishlist = wishlist.filter(item => item.productId !== productId)
        localStorage.setItem('marketplace_wishlist', JSON.stringify(updatedWishlist))

        toast({
          title: t.wishlist.remove.title,
          description: (
            <div className="flex items-center gap-2">
              <div className="relative w-8 h-8 rounded overflow-hidden">
                <Image
                  src={product.image}
                  alt={product.name}
                  fill
                  className="object-cover"
                />
              </div>
              <div>
                <p className="font-medium">{product.name}</p>
                <p className="text-sm text-gray-500">Removed from wishlist</p>
              </div>
            </div>
          ),
        })
      } else {
        const newWishlistItem = {
          productId,
          addedAt: new Date().toISOString()
        }
        setWishlist(prev => [...prev, newWishlistItem])
        
        // Save to localStorage
        const updatedWishlist = [...wishlist, newWishlistItem]
        localStorage.setItem('marketplace_wishlist', JSON.stringify(updatedWishlist))

        toast({
          title: t.wishlist.add.title,
          description: (
            <div className="flex items-center gap-2">
              <div className="relative w-8 h-8 rounded overflow-hidden">
                <Image
                  src={product.image}
                  alt={product.name}
                  fill
                  className="object-cover"
                />
              </div>
              <div>
                <p className="font-medium">{product.name}</p>
                <p className="text-sm text-gray-500">Added to wishlist</p>
              </div>
            </div>
          ),
        })
      }
    } catch (error) {
      toast({
        title: "Error",
        description: "Failed to update wishlist",
        variant: "destructive",
      })
    }
  }

  // Load wishlist from localStorage on mount
  useEffect(() => {
    const savedWishlist = localStorage.getItem('marketplace_wishlist')
    if (savedWishlist) {
      try {
        const parsedWishlist = JSON.parse(savedWishlist)
        setWishlist(parsedWishlist)
      } catch (error) {
        console.error('Failed to parse saved wishlist:', error)
      }
    }
  }, [])

  return (
    <div className="min-h-screen bg-gray-50">
      <div>Test</div>
    </div>
  )
}

export default function Marketplace() {
  return (
    <ClientOnly fallback={
      <div className="min-h-screen flex items-center justify-center bg-background">
        <div className="flex flex-col items-center gap-4">
          <div className="animate-spin rounded-full h-8 w-8 border-t-2 border-b-2 border-primary"></div>
          <p className="text-sm text-muted-foreground">Loading...</p>
        </div>
      </div>
    }>
      <MarketplaceContent />
    </ClientOnly>
  )
} 