const handleViewDCC = (dcc: DCC) => {
  setSelectedDCC(dcc)
  setIsViewDialogOpen(true)
}

const handleSendSMS = (dcc: DCC) => {
  setSelectedDCC(dcc)
  setIsSMSDialogOpen(true)
}

const handleSendEmail = (dcc: DCC) => {
  setSelectedDCC(dcc)
  setIsEmailDialogOpen(true)
}

(selectedApplication.formData.q20 as string[]).map((language: string, index: number) => (
  <Badge key={index} variant="secondary" className="bg-green-100 text-green-800">
    {language}
  </Badge>
))

type ProductStatus = "active" | "inactive" | "out_of_stock";

const { formData = {} } = selectedApplication as ApplicationData

if (application) {
  const typedAppData = application as ApplicationData;
  setFormData(typedAppData.formData || {});
  setCurrentStep(typedAppData.currentStep || 1);
  setCurrentSection(getFormSectionByStep(typedAppData.currentStep || 1));
  setHasCreatedTempAccount(true);

  toast({
    title: "Application Resumed",
    description: "Your previous application data has been loaded successfully.",
  });
}

if (import.meta.main) {
  verifyEmployerProductAccess()
