// Service functions for working with administrative divisions
export class RwandaAdministrativeService {
  private static data = rwandaAdministrativeDivisions

  // Get all provinces
  static getProvinces(): Province[] {
    return this.data
  }

  // Get districts by province ID
  static getDistrictsByProvince(provinceId: string): District[] {
    const province = this.data.find((p) => p.id === provinceId)
    return province ? province.districts : []
  }

  // Get sectors by district ID
  static getSectorsByDistrict(districtId: string): Sector[] {
    for (const province of this.data) {
      const district = province.districts.find((d) => d.id === districtId)
      if (district) {
        return district.sectors
      }
    }
    return []
  }

  // Get cells by sector ID
  static getCellsBySector(sectorId: string): Cell[] {
    for (const province of this.data) {
      for (const district of province.districts) {
        const sector = district.sectors.find((s) => s.id === sectorId)
        if (sector) {
          return sector.cells
        }
      }
    }
    return []
  }

  // Get villages by cell ID
  static getVillagesByCell(cellId: string): Village[] {
    for (const province of this.data) {
      for (const district of province.districts) {
        for (const sector of district.sectors) {
          const cell = sector.cells.find((c) => c.id === cellId)
          if (cell) {
            return cell.villages
          }
        }
      }
    }
    return []
  }

  // Get full address path
  static getFullAddressPath(villageId: string): {
    province: string
    district: string
    sector: string
    cell: string
    village: string
  } | null {
    for (const province of this.data) {
      for (const district of province.districts) {
        for (const sector of district.sectors) {
          for (const cell of sector.cells) {
            const village = cell.villages.find((v) => v.id === villageId)
            if (village) {
              return {
                province: province.name,
                district: district.name,
                sector: sector.name,
                cell: cell.name,
                village: village.name,
              }
            }
          }
        }
      }
    }
    return null
  }

  // Search locations by name
  static searchLocations(query: string): {
    provinces: Province[]
    districts: District[]
    sectors: Sector[]
    cells: Cell[]
    villages: Village[]
  } {
    const searchTerm = query.toLowerCase()
    const results = {
      provinces: [] as Province[],
      districts: [] as District[],
      sectors: [] as Sector[],
      cells: [] as Cell[],
      villages: [] as Village[],
    }

    for (const province of this.data) {
      if (province.name.toLowerCase().includes(searchTerm)) {
        results.provinces.push(province)
      }

      for (const district of province.districts) {
        if (district.name.toLowerCase().includes(searchTerm)) {
          results.districts.push(district)
        }

        for (const sector of district.sectors) {
          if (sector.name.toLowerCase().includes(searchTerm)) {
            results.sectors.push(sector)
          }

          for (const cell of sector.cells) {
            if (cell.name.toLowerCase().includes(searchTerm)) {
              results.cells.push(cell)
            }

            for (const village of cell.villages) {
              if (village.name.toLowerCase().includes(searchTerm)) {
                results.villages.push(village)
              }
            }
          }
        }
      }
    }

    return results
  }

  // Validate administrative division hierarchy
  static validateHierarchy(
    provinceId?: string,
    districtId?: string,
    sectorId?: string,
    cellId?: string,
    villageId?: string,
  ): boolean {
    if (!provinceId) return true

    const province = this.data.find((p) => p.id === provinceId)
    if (!province) return false

    if (!districtId) return true
    const district = province.districts.find((d) => d.id === districtId)
    if (!district) return false

    if (!sectorId) return true
    const sector = district.sectors.find((s) => s.id === sectorId)
    if (!sector) return false

    if (!cellId) return true
    const cell = sector.cells.find((c) => c.id === cellId)
    if (!cell) return false

    if (!villageId) return true
    const village = cell.villages.find((v) => v.id === villageId)
    return !!village
  }
}
