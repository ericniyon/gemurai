// Rwanda Administrative Divisions Data Structure
export interface Village {
  id: string
  name: string
  cellId: string
}

export interface Cell {
  id: string
  name: string
  sectorId: string
  villages: Village[]
}

export interface Sector {
  id: string
  name: string
  districtId: string
  cells: Cell[]
}

export interface District {
  id: string
  name: string
  provinceId: string
  sectors: Sector[]
}

export interface Province {
  id: string
  name: string
  districts: District[]
}

